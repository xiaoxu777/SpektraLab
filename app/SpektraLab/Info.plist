<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything else is generated from gen_project.py's INFOPLIST_KEY_* settings. -->
	<!-- The four languages Settings > Language chooses among (LOCALIZATION.md): said outright, so
	     the system offers the same four for its own pieces whatever folders a build happens to carry. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ja</string>
	</array>
	<!-- The app's own key, a build setting gen_project.py writes: the commit the build was made from.
	     Where the log is sent, and the key that server asks for, are never here: where the checkout
	     holds logs.local, gen_project.py writes build/Info-logs.plist, this file with SPKLogsURL and
	     SPKLogsKey added, and any other build has neither key. -->
	<!-- FilmLab: offered under Open With for photographs and folders (Finder, Adobe Bridge, Phocus…), never made the
	     default app for them (Alternate). A file is opened where it is (`FilmLabOpen`). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Photograph</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.hasselblad.3fr-raw-image</string>
				<string>com.hasselblad.fff-raw-image</string>
				<string>public.camera-raw-image</string>
				<string>com.adobe.raw-image</string>
				<string>public.jpeg</string>
				<string>public.tiff</string>
				<string>public.png</string>
				<string>public.heic</string>
				<string>public.heif</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder of Photographs</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>SPKCommit</key>
	<string>$(SPK_COMMIT)</string>
	<!-- Where Check for Updates reads the latest Mac release (a small JSON manifest, `UpdateCheck`): a build
	     setting gen_project.py writes (`--update-feed`), so moving the manifest to another host or CDN is a
	     build's choice, never a change to the code. -->
	<key>SPKUpdateFeedURL</key>
	<string>$(SPK_UPDATE_FEED_URL)</string>
</dict>
</plist>
